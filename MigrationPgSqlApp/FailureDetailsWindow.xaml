<mah:MetroWindow x:Class="MigrationPgSqlApp.FailureDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:models="clr-namespace:MigrationPgSqlApp.Models"
        Title="Migration Failure Details" Height="500" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#181824"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        TitleCharacterCasing="Normal"
        WindowTransitionsEnabled="False">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Search -->
        <Grid Grid.Row="0" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#FF3B30" Margin="0 0 8 0" VerticalAlignment="Center"/>
                <TextBlock Text="Failed Objects List" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Text=" (0 items)" FontSize="13" Foreground="#8F8F9F" VerticalAlignment="Center" Margin="5 0 0 0"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Column="1" 
                     mah:TextBoxHelper.Watermark="Search object name or error..." 
                     mah:TextBoxHelper.ClearTextButton="True"
                     TextChanged="SearchBox_TextChanged"
                     Background="#0F0F16" Foreground="White" BorderBrush="#2D2D3F" BorderThickness="1"/>
        </Grid>

        <!-- Failures List -->
        <Border Grid.Row="1" Background="#0F0F16" BorderBrush="#252538" BorderThickness="1" CornerRadius="4" Margin="0 0 0 10">
            <DataGrid x:Name="FailuresGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F1F2F"
                      RowBackground="Transparent" AlternatingRowBackground="#12121D"
                      SelectionChanged="FailuresGrid_SelectionChanged" SelectionMode="Single"
                      Foreground="White">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#14141F"/>
                        <Setter Property="Foreground" Value="#8F8F9F"/>
                        <Setter Property="Padding" Value="10 8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10 6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2E1A47"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding DisplayType}" Width="100"/>
                    <DataGridTextColumn Header="Object Name" Binding="{Binding Name}" Width="250"/>
                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Selected Error Details -->
        <Border Grid.Row="2" Background="#0A0A0F" BorderBrush="#20202F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 0 10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Detailed Error Reason:" FontSize="11" Foreground="#8F8F9F" FontWeight="SemiBold" Margin="0 0 0 4"/>
                <TextBox x:Name="DetailText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                         Background="Transparent" Foreground="#FF5B55" BorderThickness="0" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy Error Info" Click="CopyButton_Click" Width="120" Height="30" Margin="0 0 10 0"
                        Style="{StaticResource MahApps.Styles.Button.Flat}" Background="#2A1B3D" Foreground="White"/>
                <Button Content="Close" Click="CloseButton_Click" Width="80" Height="30"
                        Style="{StaticResource MahApps.Styles.Button.Flat}" Background="#1F1F2F" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
