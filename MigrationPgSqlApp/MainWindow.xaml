<mah:MetroWindow x:Class="MigrationPgSqlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:viewModels="clr-namespace:MigrationPgSqlApp.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:MigrationPgSqlApp.Models"
        mc:Ignorable="d"
        Title="Antigravity Migration Studio" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#181824"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        TitleCharacterCasing="Normal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>
        
        <!-- Modern Styled Secondary/Outline Button -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#222234"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#3B3B54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E2E48"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5A5A80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#181826"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Styled Primary/Accent Button -->
        <Style x:Key="ModernAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="20 0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Danger Button -->
        <Style x:Key="ModernDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom text box style for dark premium code feel -->
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F0F16" />
            <Setter Property="Foreground" Value="#7FFF00" />
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#2D2D3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#12121A" BorderBrush="#2D2D3F" BorderThickness="0 0 0 1" Padding="15 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="DatabaseImport" Width="26" Height="26" Foreground="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                    <TextBlock Text="{Binding Lang.AppTitle}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Lang.AppSubtitle}" FontSize="12" Foreground="#8A8A9F" Margin="15 0 0 0" VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector Dropdown -->
                    <Border Background="#222230" CornerRadius="4" Padding="6 2" Margin="0 0 12 0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Translate" Width="14" Height="14" Foreground="#A9A9C9" VerticalAlignment="Center" Margin="0 0 5 0"/>
                            <ComboBox SelectedIndex="{Binding Lang.SelectedLanguageIndex, Mode=TwoWay}" Width="100" Height="24" FontSize="11" Background="Transparent" Foreground="White" BorderThickness="0">
                                <ComboBoxItem Content="简体中文"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Status Indicators -->
                    <Border Background="#222230" CornerRadius="4" Padding="8 4" Margin="5 0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionVM.IsSourceSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Red}" Margin="0 0 5 0"/>
                            <TextBlock Text="{Binding Lang.SourceDbHeader}" FontSize="11" Foreground="#A9A9C9"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#222230" CornerRadius="4" Padding="8 4" Margin="5 0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionVM.IsPgSuccess, Converter={StaticResource BoolToVis}, FallbackValue=Red}" Margin="0 0 5 0"/>
                            <TextBlock Text="{Binding Lang.TargetDbHeader}" FontSize="11" Foreground="#A9A9C9"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <mah:MetroAnimatedSingleRowTabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex}" TabStripPlacement="Top" Background="#14141E">
            
            <!-- Tab 1: Database Connections -->
            <TabItem Header="{Binding Lang.Tab1Header}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Source Database Panel -->
                        <Border Grid.Column="0" Margin="10" Background="#1C1C2B" BorderBrush="#2E2E42" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <Grid Margin="0 0 0 15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="Database" Width="22" Height="22" Foreground="#FF8C00" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                        <TextBlock Text="{Binding Lang.SourceDbPanelHeader}" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Source DB Type Selector -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="Oracle" IsChecked="{Binding ConnectionVM.IsSourceOracle, Mode=TwoWay}" Foreground="White" Margin="0 0 10 0"/>
                                        <RadioButton Content="PostgreSQL" IsChecked="{Binding ConnectionVM.IsSourcePg, Mode=TwoWay}" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Oracle Connection Panel -->
                                <StackPanel Visibility="{Binding ConnectionVM.IsSourceOracle, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0 5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ConnectionVM.OraHost, UpdateSourceTrigger=PropertyChanged}" 
                                                 mah:TextBoxHelper.Watermark="Host (IP / Domain)" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 0 5 0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ConnectionVM.OraPort, UpdateSourceTrigger=PropertyChanged}" 
                                                 mah:TextBoxHelper.Watermark="Port" mah:TextBoxHelper.UseFloatingWatermark="True"/>
                                    </Grid>

                                    <Grid Margin="0 5">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>
                                         <TextBox Text="{Binding ConnectionVM.OraServiceOrSid, UpdateSourceTrigger=PropertyChanged}" 
                                                  mah:TextBoxHelper.Watermark="Service Name / SID" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0 0 0">
                                             <RadioButton Content="Service" IsChecked="{Binding ConnectionVM.OraIsService, Mode=TwoWay}" Foreground="White" FontSize="11" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                             <RadioButton Content="SID" IsChecked="{Binding ConnectionVM.OraIsSid, Mode=TwoWay}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Grid>

                                     <TextBox Text="{Binding ConnectionVM.OraUser, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Username" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>
                                     <PasswordBox Name="OraPasswordBox" mah:TextBoxHelper.Watermark="Password" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5" PasswordChanged="OraPasswordChanged"/>
                                     <TextBox Text="{Binding ConnectionVM.OraSchema, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Schema (Leave blank for default user schema)" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>

                                     <Button Command="{Binding ConnectionVM.TestOracleCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0 15 0 5">
                                         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                             <iconPacks:PackIconMaterial Kind="DatabaseCheck" Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center" Foreground="#FF9800"/>
                                             <TextBlock Text="{Binding Lang.TestOraBtn}" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Button>
                                    <TextBlock Text="{Binding ConnectionVM.OraStatus}" FontSize="11" Foreground="#FFCC00" TextWrapping="Wrap" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Source PostgreSQL Connection Panel -->
                                <StackPanel Visibility="{Binding ConnectionVM.IsSourcePg, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0 5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ConnectionVM.SrcPgHost, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Host (IP / Domain)" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 0 5 0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ConnectionVM.SrcPgPort, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Port" mah:TextBoxHelper.UseFloatingWatermark="True"/>
                                    </Grid>

                                    <TextBox Text="{Binding ConnectionVM.SrcPgDatabase, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Source Database Name" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>
                                    <TextBox Text="{Binding ConnectionVM.SrcPgUser, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Username" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>
                                    <PasswordBox Name="SrcPgPasswordBox" mah:TextBoxHelper.Watermark="Password" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5" PasswordChanged="SrcPgPasswordChanged"/>
                                    <TextBox Text="{Binding ConnectionVM.SrcPgSchema, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Source Schema (e.g. public)" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>

                                    <Button Command="{Binding ConnectionVM.TestSrcPgCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0 15 0 5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="DatabaseCheck" Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                            <TextBlock Text="{Binding Lang.TestSrcPgBtn}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding ConnectionVM.SrcPgStatus}" FontSize="11" Foreground="#FFCC00" TextWrapping="Wrap" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PostgreSQL Connection Panel -->
                        <Border Grid.Column="1" Margin="10" Background="#1C1C2B" BorderBrush="#2E2E42" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                                    <iconPacks:PackIconMaterial Kind="Database" Width="22" Height="22" Foreground="#4169E1" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                    <TextBlock Text="{Binding Lang.TargetDbPanelHeader}" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0 5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ConnectionVM.PgHost, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Host (IP / Domain)" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 0 5 0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ConnectionVM.PgPort, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Port" mah:TextBoxHelper.UseFloatingWatermark="True"/>
                                </Grid>

                                <TextBox Text="{Binding ConnectionVM.PgDatabase, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Database Name" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>
                                <TextBox Text="{Binding ConnectionVM.PgUser, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Username" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>
                                <PasswordBox Name="PgPasswordBox" mah:TextBoxHelper.Watermark="Password" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5" PasswordChanged="PgPasswordChanged"/>
                                <TextBox Text="{Binding ConnectionVM.PgSchema, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Target Schema" mah:TextBoxHelper.UseFloatingWatermark="True" Margin="0 5"/>

                                <Button Command="{Binding ConnectionVM.TestPgCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0 15 0 5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="DatabaseCheck" Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                        <TextBlock Text="{Binding Lang.TestPgBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding ConnectionVM.PgStatus}" FontSize="11" Foreground="#FFCC00" TextWrapping="Wrap" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Load Metadata Button -->
                        <Button Grid.Row="1" Grid.ColumnSpan="2" Command="{Binding LoadMetadataCommand}" Style="{StaticResource ModernAccentButton}" Margin="10 15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="DatabaseSync" Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Lang.ConnectLoadBtn}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Object Navigator & Code Preview -->
            <TabItem Header="{Binding Lang.Tab2Header}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Metadata Explorer -->
                    <Border Grid.Column="0" Background="#181826" BorderBrush="#252538" BorderThickness="0 0 1 0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1C1C2E" Padding="10 8" BorderBrush="#252538" BorderThickness="0 0 0 1">
                                <TextBlock Text="{Binding Lang.ChecklistHeader}" Foreground="#A0A0C0" FontSize="12" FontWeight="SemiBold"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    
                                    <!-- Tables Category -->
                                    <Expander Header="{Binding Lang.TablesHeader}" IsExpanded="True" Foreground="White" BorderBrush="#252538" Margin="0 0 0 8">
                                        <StackPanel Margin="5 0 0 0">
                                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                                <Button Content="{Binding Lang.AllBtn}" Padding="6 2" FontSize="10" Command="{Binding SchemaTreeVM.ToggleAllTablesCommand}" CommandParameter="{StaticResource True}"/>
                                                <Button Content="{Binding Lang.NoneBtn}" Padding="6 2" FontSize="10" Margin="5 0 0 0" Command="{Binding SchemaTreeVM.ToggleAllTablesCommand}" CommandParameter="{StaticResource False}"/>
                                            </StackPanel>
                                            
                                            <ListBox ItemsSource="{Binding SchemaTreeVM.Tables}" SelectedItem="{Binding ObjectPreviewVM.SelectedItem}" Background="Transparent" BorderThickness="0" Margin="0 5">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <iconPacks:PackIconMaterial Kind="Table" Width="14" Height="14" Foreground="#7FDF4B" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding RowCount, StringFormat='({0})'}" Foreground="#5F5F7A" FontSize="10" Margin="5 0 0 0" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Views Category -->
                                    <Expander Header="{Binding Lang.ViewsHeader}" IsExpanded="False" Foreground="White" BorderBrush="#252538" Margin="0 0 0 8">
                                        <StackPanel Margin="5 0 0 0">
                                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                                <Button Content="{Binding Lang.AllBtn}" Padding="6 2" FontSize="10" Command="{Binding SchemaTreeVM.ToggleAllViewsCommand}" CommandParameter="{StaticResource True}"/>
                                                <Button Content="{Binding Lang.NoneBtn}" Padding="6 2" FontSize="10" Margin="5 0 0 0" Command="{Binding SchemaTreeVM.ToggleAllViewsCommand}" CommandParameter="{StaticResource False}"/>
                                            </StackPanel>
                                            
                                            <ListBox ItemsSource="{Binding SchemaTreeVM.Views}" SelectedItem="{Binding ObjectPreviewVM.SelectedItem}" Background="Transparent" BorderThickness="0" Margin="0 5">
                                                <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid Margin="2">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <CheckBox IsChecked="{Binding IsSelected}" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                 <iconPacks:PackIconMaterial Kind="Eye" Width="14" Height="14" Foreground="#4BC5DF" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                                 <TextBlock Text="{Binding Name}" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                             </StackPanel>
                                                         </Grid>
                                                     </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Sequences Category -->
                                    <Expander Header="{Binding Lang.SequencesHeader}" IsExpanded="False" Foreground="White" BorderBrush="#252538" Margin="0 0 0 8">
                                        <StackPanel Margin="5 0 0 0">
                                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                                <Button Content="{Binding Lang.AllBtn}" Padding="6 2" FontSize="10" Command="{Binding SchemaTreeVM.ToggleAllSequencesCommand}" CommandParameter="{StaticResource True}"/>
                                                <Button Content="{Binding Lang.NoneBtn}" Padding="6 2" FontSize="10" Margin="5 0 0 0" Command="{Binding SchemaTreeVM.ToggleAllSequencesCommand}" CommandParameter="{StaticResource False}"/>
                                            </StackPanel>
                                            
                                            <ListBox ItemsSource="{Binding SchemaTreeVM.Sequences}" SelectedItem="{Binding ObjectPreviewVM.SelectedItem}" Background="Transparent" BorderThickness="0" Margin="0 5">
                                                <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid Margin="2">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <CheckBox IsChecked="{Binding IsSelected}" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                 <iconPacks:PackIconMaterial Kind="Numeric" Width="14" Height="14" Foreground="#FFCC00" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                                 <TextBlock Text="{Binding Name}" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                             </StackPanel>
                                                         </Grid>
                                                     </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Indexes Category -->
                                    <Expander Header="{Binding Lang.IndexesHeader}" IsExpanded="False" Foreground="White" BorderBrush="#252538" Margin="0 0 0 8">
                                        <StackPanel Margin="5 0 0 0">
                                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                                <Button Content="{Binding Lang.AllBtn}" Padding="6 2" FontSize="10" Command="{Binding SchemaTreeVM.ToggleAllIndexesCommand}" CommandParameter="{StaticResource True}"/>
                                                <Button Content="{Binding Lang.NoneBtn}" Padding="6 2" FontSize="10" Margin="5 0 0 0" Command="{Binding SchemaTreeVM.ToggleAllIndexesCommand}" CommandParameter="{StaticResource False}"/>
                                            </StackPanel>
                                            
                                            <ListBox ItemsSource="{Binding SchemaTreeVM.Indexes}" SelectedItem="{Binding ObjectPreviewVM.SelectedItem}" Background="Transparent" BorderThickness="0" Margin="0 5">
                                                <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid Margin="2">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <CheckBox IsChecked="{Binding IsSelected}" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                 <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="14" Height="14" Foreground="#DFA24B" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                                 <TextBlock Text="{Binding Name}" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                             </StackPanel>
                                                         </Grid>
                                                     </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Procedures/Functions/Packages Category -->
                                    <Expander Header="{Binding Lang.ProceduresHeader}" IsExpanded="False" Foreground="White" BorderBrush="#252538" Margin="0 0 0 8">
                                        <StackPanel Margin="5 0 0 0">
                                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                                <Button Content="{Binding Lang.AllBtn}" Padding="6 2" FontSize="10" Command="{Binding SchemaTreeVM.ToggleAllProceduresCommand}" CommandParameter="{StaticResource True}"/>
                                                <Button Content="{Binding Lang.NoneBtn}" Padding="6 2" FontSize="10" Margin="5 0 0 0" Command="{Binding SchemaTreeVM.ToggleAllProceduresCommand}" CommandParameter="{StaticResource False}"/>
                                            </StackPanel>
                                            
                                            <ListBox ItemsSource="{Binding SchemaTreeVM.Procedures}" SelectedItem="{Binding ObjectPreviewVM.SelectedItem}" Background="Transparent" BorderThickness="0" Margin="0 5">
                                                <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid Margin="2">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <CheckBox IsChecked="{Binding IsSelected}" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                 <iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" Foreground="#7FDF4B" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                                 <TextBlock Text="{Binding Name}" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                             </StackPanel>
                                                         </Grid>
                                                     </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Triggers Category -->
                                    <Expander Header="{Binding Lang.TriggersHeader}" IsExpanded="False" Foreground="White" BorderBrush="#252538">
                                        <StackPanel Margin="5 0 0 0">
                                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                                <Button Content="{Binding Lang.AllBtn}" Padding="6 2" FontSize="10" Command="{Binding SchemaTreeVM.ToggleAllTriggersCommand}" CommandParameter="{StaticResource True}"/>
                                                <Button Content="{Binding Lang.NoneBtn}" Padding="6 2" FontSize="10" Margin="5 0 0 0" Command="{Binding SchemaTreeVM.ToggleAllTriggersCommand}" CommandParameter="{StaticResource False}"/>
                                            </StackPanel>
                                            
                                            <ListBox ItemsSource="{Binding SchemaTreeVM.Triggers}" SelectedItem="{Binding ObjectPreviewVM.SelectedItem}" Background="Transparent" BorderThickness="0" Margin="0 5">
                                                <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid Margin="2">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <CheckBox IsChecked="{Binding IsSelected}" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                 <iconPacks:PackIconMaterial Kind="Flash" Width="14" Height="14" Foreground="#FF3B30" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                                 <TextBlock Text="{Binding Name}" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                             </StackPanel>
                                                         </Grid>
                                                     </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Splitter Grid -->
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#12121A"/>

                    <!-- Right: Object Preview Details -->
                    <Grid Grid.Column="2" Background="#12121C">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Navigator bar -->
                        <Border Grid.Row="0" Background="#161622" Padding="15 10" BorderBrush="#252538" BorderThickness="0 0 0 1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="CodeTags" Width="18" Height="18" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Lang.ConvertedCodeHeader}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ObjectPreviewVM.SelectedItem.Name, StringFormat=' - \{0\}'}" FontSize="14" Foreground="#FFCC00" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Target PG Schema:" VerticalAlignment="Center" Foreground="#8F8F9F" FontSize="11" Margin="0 0 8 0"/>
                                    <TextBox Width="100" Height="22" FontSize="11" Text="{Binding ObjectPreviewVM.TargetSchema, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Preview Areas -->
                        <Grid Grid.Row="1" Margin="15">
                            
                            <!-- Table columns details vs generated DDL -->
                            <Grid Visibility="{Binding ObjectPreviewVM.SelectedTable, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table column definition list -->
                                <Border Grid.Row="0" Background="#181826" BorderBrush="#252538" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#1C1C2E" Padding="10 5" CornerRadius="4 4 0 0">
                                            <TextBlock Text="{Binding Lang.ColumnMappingHeader}" FontSize="11" Foreground="#A9A9B9" FontWeight="SemiBold"/>
                                        </Border>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ObjectPreviewVM.SelectedTable.Columns}" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                                                  Background="Transparent" RowBackground="#161622" AlternatingRowBackground="#1A1A2A" 
                                                  BorderThickness="0" Foreground="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Column Name" Binding="{Binding Name}" Width="2*"/>
                                                <DataGridTextColumn Header="Oracle Type" Binding="{Binding OracleType}" Width="*"/>
                                                <DataGridTextColumn Header="Length/Scale" Binding="{Binding Length}" Width="80"/>
                                                <DataGridTextColumn Header="PostgreSQL Type" Binding="{Binding PgType}" Width="1.5*"/>
                                                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable}" Width="70"/>
                                                <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey}" Width="40"/>
                                                <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#12121C"/>

                                <!-- Table DDL output -->
                                <Border Grid.Row="2" Background="#181826" BorderBrush="#252538" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#1C1C2E" Padding="10 5">
                                            <TextBlock Text="{Binding Lang.GeneratedDdlHeader}" FontSize="11" Foreground="#A9A9B9" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBox Grid.Row="1" Text="{Binding ObjectPreviewVM.ConvertedSql, Mode=OneWay}" Style="{StaticResource CodeTextBoxStyle}" IsReadOnly="True"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Side-by-side view editor (for View, Stored procedures) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ObjectPreviewVM.SelectedTable}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left original code panel -->
                                <Border Grid.Column="0" Background="#181826" BorderBrush="#252538" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#1C1C2E" Padding="10 5">
                                            <TextBlock Text="{Binding Lang.OriginalCodeHeader}" FontSize="11" Foreground="#A9A9B9" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBox Grid.Row="1" Text="{Binding ObjectPreviewVM.SourceSql, Mode=OneWay}" Style="{StaticResource CodeTextBoxStyle}" IsReadOnly="True"/>
                                    </Grid>
                                </Border>

                                <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" Background="#12121C"/>

                                <!-- Right converted editable code panel -->
                                <Border Grid.Column="2" Background="#181826" BorderBrush="#252538" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#1C1C2E" Padding="10 5">
                                            <TextBlock Text="{Binding Lang.ConvertedCodeHeader}" FontSize="11" Foreground="#A9A9B9" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBox Grid.Row="1" Text="{Binding ObjectPreviewVM.ConvertedSql, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeTextBoxStyle}"/>
                                        <Border Grid.Row="2" Background="#1E1E2C" Padding="10 5" BorderBrush="#252538" BorderThickness="0 1 0 0">
                                            <TextBlock Text="{Binding Lang.EditNote}" FontSize="10" Foreground="#8A8A9F" FontStyle="Italic"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Migration Logs & Console -->
            <TabItem Header="{Binding Lang.Tab3Header}">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Migration Panel -->
                    <Border Grid.Column="0" Background="#1C1C2B" BorderBrush="#2E2E42" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                                    <iconPacks:PackIconMaterial Kind="Tune" Width="20" Height="20" Foreground="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                    <TextBlock Text="{Binding Lang.OptionsHeader}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding ProgressVM.MigrateSchema}" Content="{Binding Lang.MigrateSchemaText}" Margin="0 8" VerticalContentAlignment="Center"/>
                                <CheckBox IsChecked="{Binding ProgressVM.MigrateSequences}" Content="{Binding Lang.MigrateSeqsText}" Margin="0 8" VerticalContentAlignment="Center"/>
                                <CheckBox IsChecked="{Binding ProgressVM.MigrateIndexes}" Content="{Binding Lang.MigrateIdxsText}" Margin="0 8" VerticalContentAlignment="Center"/>
                                <CheckBox IsChecked="{Binding ProgressVM.MigrateData}" Content="{Binding Lang.MigrateDataText}" Margin="0 8" VerticalContentAlignment="Center"/>
                                <CheckBox IsChecked="{Binding ProgressVM.TruncateBeforeCopy}" Content="{Binding Lang.TruncateText}" Margin="15 4" IsEnabled="{Binding ProgressVM.MigrateData}" VerticalContentAlignment="Center"/>
                                <CheckBox IsChecked="{Binding ProgressVM.MigrateProcedures}" Content="{Binding Lang.MigrateProcsText}" Margin="0 8" VerticalContentAlignment="Center"/>
                                <CheckBox IsChecked="{Binding ProgressVM.MigrateTriggers}" Content="{Binding Lang.MigrateTrigsText}" Margin="0 8" VerticalContentAlignment="Center"/>
                            </StackPanel>

                             <!-- List of objects being migrated -->
                             <Border Grid.Row="1" Margin="0 15" BorderBrush="#2E2E42" BorderThickness="0 1 0 0" Padding="0 15 0 0">
                                 <Grid>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="*"/>
                                     </Grid.RowDefinitions>
                                     <TextBlock Text="{Binding Lang.StatusListHeader}" FontSize="11" Foreground="#8F8F9F" FontWeight="SemiBold" Margin="0 0 0 8"/>
                                     <ListBox Grid.Row="1" ItemsSource="{Binding ProgressVM.MigratingObjects}" Background="Transparent" BorderThickness="0">
                                         <ListBox.Resources>
                                             <Style x:Key="StatusStyle" TargetType="TextBlock">
                                                 <Style.Triggers>
                                                     <Trigger Property="Text" Value="Pending">
                                                         <Setter Property="Foreground" Value="#8F8F8F"/>
                                                     </Trigger>
                                                     <Trigger Property="Text" Value="Migrating">
                                                         <Setter Property="Foreground" Value="#FFCC00"/>
                                                     </Trigger>
                                                     <Trigger Property="Text" Value="Success">
                                                         <Setter Property="Foreground" Value="#7FDF4B"/>
                                                     </Trigger>
                                                     <Trigger Property="Text" Value="Failed">
                                                         <Setter Property="Foreground" Value="#FF3B30"/>
                                                     </Trigger>
                                                 </Style.Triggers>
                                             </Style>

                                             <!-- DataTemplate for DbTable -->
                                             <DataTemplate DataType="{x:Type models:DbTable}">
                                                 <Grid Margin="0 2">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <iconPacks:PackIconMaterial Kind="Table" Width="12" Height="12" Foreground="#8F8F8F" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                     <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Margin="5 0 0 0" VerticalAlignment="Center" Style="{StaticResource StatusStyle}"/>
                                                 </Grid>
                                             </DataTemplate>

                                             <!-- DataTemplate for DbView -->
                                             <DataTemplate DataType="{x:Type models:DbView}">
                                                 <Grid Margin="0 2">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <iconPacks:PackIconMaterial Kind="Eye" Width="12" Height="12" Foreground="#4BC5DF" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                     <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Margin="5 0 0 0" VerticalAlignment="Center" Style="{StaticResource StatusStyle}"/>
                                                 </Grid>
                                             </DataTemplate>

                                             <!-- DataTemplate for DbSequence -->
                                             <DataTemplate DataType="{x:Type models:DbSequence}">
                                                 <Grid Margin="0 2">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <iconPacks:PackIconMaterial Kind="Numeric" Width="12" Height="12" Foreground="#FFCC00" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                     <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Margin="5 0 0 0" VerticalAlignment="Center" Style="{StaticResource StatusStyle}"/>
                                                 </Grid>
                                             </DataTemplate>

                                             <!-- DataTemplate for DbIndex -->
                                             <DataTemplate DataType="{x:Type models:DbIndex}">
                                                 <Grid Margin="0 2">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="12" Height="12" Foreground="#DFA24B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                     <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Margin="5 0 0 0" VerticalAlignment="Center" Style="{StaticResource StatusStyle}"/>
                                                 </Grid>
                                             </DataTemplate>

                                             <!-- DataTemplate for DbProcedure -->
                                             <DataTemplate DataType="{x:Type models:DbProcedure}">
                                                 <Grid Margin="0 2">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <iconPacks:PackIconMaterial Kind="Play" Width="12" Height="12" Foreground="#7FDF4B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                     <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Margin="5 0 0 0" VerticalAlignment="Center" Style="{StaticResource StatusStyle}"/>
                                                 </Grid>
                                             </DataTemplate>

                                             <!-- DataTemplate for DbTrigger -->
                                             <DataTemplate DataType="{x:Type models:DbTrigger}">
                                                 <Grid Margin="0 2">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <iconPacks:PackIconMaterial Kind="Flash" Width="12" Height="12" Foreground="#FF3B30" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                     <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#E4E4F4" TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Margin="5 0 0 0" VerticalAlignment="Center" Style="{StaticResource StatusStyle}"/>
                                                 </Grid>
                                             </DataTemplate>
                                         </ListBox.Resources>
                                     </ListBox>
                                 </Grid>
                             </Border>

                            <!-- Control Buttons -->
                            <StackPanel Grid.Row="2">
                                <Button Command="{Binding StartMigrationCommand}" Style="{StaticResource ModernAccentButton}" Height="40" Margin="0 5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="PlayCircle" Width="18" Height="18" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Lang.RunPipelineBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ProgressVM.CancelCommand}" Style="{StaticResource ModernDangerButton}" Margin="0 5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="StopCircle" Width="14" Height="14" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Lang.CancelBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Logger Panel -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Progress Bar Block -->
                         <Border Grid.Row="0" Background="#1C1C2B" BorderBrush="#2E2E42" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0 0 0 15">
                             <StackPanel>
                                 <Grid Margin="0 0 0 10">
                                     <TextBlock Text="{Binding ProgressVM.StatusText}" FontSize="13" Foreground="White" FontWeight="SemiBold"/>
                                     <TextBlock Text="{Binding ProgressVM.Progress, StringFormat='\{0:0\}%'}" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                 </Grid>
                                 <ProgressBar Height="15" Value="{Binding ProgressVM.Progress, Mode=OneWay}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Background="#12121A" BorderBrush="#2E2E42" Margin="0 0 0 8"/>
                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                      <TextBlock Text="{Binding Lang.SuccessText}" FontSize="11" Foreground="#8F8F9F" VerticalAlignment="Center"/>
                                      <TextBlock Text="{Binding ProgressVM.SuccessCount}" FontSize="12" Foreground="#7FDF4B" FontWeight="Bold" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                      
                                      <!-- Clickable Failures Button -->
                                      <Button Command="{Binding ProgressVM.ShowFailuresCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0" VerticalAlignment="Center">
                                          <Button.Template>
                                              <ControlTemplate TargetType="Button">
                                                  <StackPanel Orientation="Horizontal">
                                                      <TextBlock Text="{Binding DataContext.Lang.FailedText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="#8F8F9F" VerticalAlignment="Center"/>
                                                      <TextBlock Text="{Binding DataContext.ProgressVM.FailureCount, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="#FF3B30" FontWeight="Bold" VerticalAlignment="Center"/>
                                                      <TextBlock Text="{Binding DataContext.Lang.ViewDetailsText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="#5A8FDF" Margin="5 0 0 0" VerticalAlignment="Center" TextDecorations="Underline"/>
                                                  </StackPanel>
                                                  <ControlTemplate.Triggers>
                                                      <Trigger Property="IsMouseOver" Value="True">
                                                          <Setter Property="Opacity" Value="0.8"/>
                                                      </Trigger>
                                                  </ControlTemplate.Triggers>
                                              </ControlTemplate>
                                          </Button.Template>
                                      </Button>
                                  </StackPanel>
                             </StackPanel>
                         </Border>

                        <!-- Log Console Block -->
                        <Border Grid.Row="1" Background="#0F0F16" BorderBrush="#252538" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#14141F" Padding="15 10" CornerRadius="8 8 0 0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Console" Width="16" Height="16" Foreground="#7FFF00" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Lang.LogsHeader}" FontSize="12" FontWeight="SemiBold" Foreground="#A0A0C0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBox Grid.Row="1" Text="{Binding ProgressVM.LogOutput, Mode=OneWay}" 
                                         Background="Transparent" Foreground="#8FDF3F" BorderThickness="0" FontFamily="Consolas" FontSize="12" 
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                         IsReadOnly="True" Margin="10" TextChanged="LogTextBox_TextChanged"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </TabItem>
            
        </mah:MetroAnimatedSingleRowTabControl>

        <!-- Loading spinner overlay -->
        <Grid Grid.RowSpan="2" Background="#A0000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing Foreground="{DynamicResource MahApps.Brushes.Accent}" Width="60" Height="60"/>
                <TextBlock Text="{Binding Lang.ReadingMetadataText}" Margin="0 15 0 0" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
